# Environment variables for Android Capacitor Employee App
# Copy this file to .env in your Capacitor React project root

# Supabase Public API Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Android / WebAuthn Configuration
VITE_AUTH_RP_ID=
VITE_AUTH_ORIGIN=

# Optional: Dedicated Edge Function Endpoint URL (if not using standard supabase.functions.invoke)
VITE_BIOMETRIC_EDGE_URL=
