                "{{base_url}}"
              ],
              "path": [
                "_server",
                "saveQuarterlyEvaluation"
              ]
            },
            "description": "Saves draft or submits quarterly review. Server enforces score formula: achievement = min(1, actual/target), score = sum(achv * weight * 100)."
          }
        },
