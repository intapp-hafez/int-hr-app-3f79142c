{
  "info": {
    "_postman_id": "c8e1927d-789a-4c28-98f5-b28392019482",
    "name": "INT HR System API Collection",
    "description": "Complete, production-ready Postman Collection for the INT HR application. Covers all TanStack Start server functions, Supabase Edge Functions, and REST endpoints for Auth, Attendance, Biometrics, Leaves, Payroll, Solaf (Advances), and the new 3-Layer Quarterly KPI & Performance Evaluation module.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5173",
      "type": "string",
      "description": "App base URL (TanStack Start Server Functions)"
    },
    {
      "key": "supabase_url",
      "value": "https://hydakxwzpfzwolencnmp.supabase.co",
      "type": "string",
      "description": "Remote Supabase project API URL"
    },
    {
      "key": "jwt_token",
      "value": "YOUR_SUPABASE_JWT_ACCESS_TOKEN",
      "type": "string",
      "description": "Bearer authentication token for the signed-in user"
    },
    {
      "key": "supabase_anon_key",
      "value": "YOUR_SUPABASE_ANON_KEY",
      "type": "string",
      "description": "Public client publishable anon key"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Profile",
      "description": "Supabase identity authentication, user role extraction, and employee profile inspection.",
      "item": [
        {
          "name": "Supabase Sign-In (Get JWT Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "apikey",
                "value": "{{supabase_anon_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@int.com\",\n  \"password\": \"YourPassword123!\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
              "host": [
                "{{supabase_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Authenticates with Supabase Auth and returns an access_token JWT."
          }
        },
        {
          "name": "Get Current User & Roles (getMe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/_server/getMe",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "_server",
                "getMe"
              ]
            },
            "description": "Extracts session and returns current user ID, email, emp_code, and active database roles from public.user_roles."
          }
        },
        {
          "name": "Get Full Profile Details (getMyProfileDetails)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/_server/getMyProfileDetails",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "_server",
                "getMyProfileDetails"
              ]
            },
            "description": "Returns employee profile including bilingual position, department, direct manager, and base salary."
          }
        },
        {
          "name": "Change Account Password (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"targetUserId\": \"00000000-0000-0000-0000-000000000000\",\n    \"newPassword\": \"NewSecurePassword2026!\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/_server/changeAccountPassword",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "_server",
                "changeAccountPassword"
              ]
            },
            "description": "Allows Admin to change password for any account using the deployed isolated send-smtp-email service."
          }
        }
      ]
    },
