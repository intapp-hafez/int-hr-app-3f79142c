    {
      "name": "3. Attendance & Biometric Verification",
      "description": "GPS geofence attendance check-in/out, biometric liveness challenges, and anti-spoofing verification.",
      "item": [
        {
          "name": "Generate Biometric Challenge Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"deviceId\": \"android_pixel_8_hw_id_98234\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/_server/createBiometricChallenge",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "_server",
                "createBiometricChallenge"
              ]
            },
            "description": "Generates a single-use cryptographic verification token (120-second TTL) and liveness gesture requirement."
          }
        },
        {
          "name": "Attendance Check-In (GPS + Biometrics)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"latitude\": 30.0444,\n    \"longitude\": 31.2357,\n    \"accuracy\": 8.5,\n    \"verificationToken\": \"token_from_challenge_endpoint\",\n    \"selfieBase64\": \"data:image/jpeg;base64,/9j/4AAQSkZJRg...\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/_server/checkInAttendance",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "_server",
                "checkInAttendance"
              ]
            },
            "description": "Executes anti-spoofing checks, verifies geofence radius, and records check-in punch in attendance_logs."
          }
        },
        {
          "name": "Attendance Check-Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"latitude\": 30.0444,\n    \"longitude\": 31.2357,\n    \"accuracy\": 9,\n    \"verificationToken\": \"token_from_challenge_endpoint\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/_server/checkOutAttendance",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "_server",
                "checkOutAttendance"
              ]
            },
            "description": "Logs departure punch for the employee."
          }
        },
        {
          "name": "List Attendance Logs (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"startDate\": \"2026-11-01\",\n    \"endDate\": \"2026-11-30\",\n    \"departmentId\": null,\n    \"page\": 1,\n    \"pageSize\": 25\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/_server/listAttendanceLogsAdmin",
