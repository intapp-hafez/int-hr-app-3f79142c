    {
      "name": "6. KPI & Performance Evaluations (Quarterly)",
      "description": "3-Layer Criteria Catalog (Common 40%, Role 60%, Custom), Q1-Q4 Quarterly Evaluations, and HR Approval Queue.",
      "item": [
        {
          "name": "List Criteria Catalog (listKpiCriteria)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"layer\": \"all\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/_server/listKpiCriteria",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "_server",
                "listKpiCriteria"
              ]
            },
            "description": "Fetches active KPI criteria catalog filtered by layer ('all', 'common', 'role', 'custom')."
          }
        },
        {
          "name": "Save KPI Criterion (Admin / HR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"code\": \"KPI-108\",\n    \"name_en\": \"System Commissioning & Startup Accuracy\",\n    \"name_ar\": \"دقة تشغيل وبدء تشغيل الأنظمة\",\n    \"category_en\": \"Commissioning & Programming\",\n    \"category_ar\": \"التشغيل والبرمجة\",\n    \"layer\": \"role\",\n    \"default_weight\": 0.1,\n    \"default_target\": 0.9,\n    \"unit\": \"%\",\n    \"how_measured_en\": \"% of systems passing startup on first test\",\n    \"how_measured_ar\": \"نسبة الأنظمة التي تجتاز التشغيل من أول فحص\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/_server/saveKpiCriterion",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "_server",
                "saveKpiCriterion"
              ]
            },
            "description": "Adds or updates a criterion in the catalog with bilingual naming, default weights, and measurement method."
          }
        },
        {
          "name": "Get Quarterly Evaluation (getQuarterlyEvaluation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"employeeId\": \"00000000-0000-0000-0000-000000000000\",\n    \"year\": 2026,\n    \"quarter\": \"q1\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/_server/getQuarterlyEvaluation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "_server",
                "getQuarterlyEvaluation"
              ]
            },
            "description": "Returns quarterly header, status ('draft', 'submitted', 'returned', 'approved'), return_reason, and scored items."
          }
        },
        {
          "name": "Save / Submit Quarterly Evaluation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"employeeId\": \"00000000-0000-0000-0000-000000000000\",\n    \"year\": 2026,\n    \"quarter\": \"q1\",\n    \"items\": [\n      {\n        \"criterionId\": \"00000000-0000-0000-0000-000000000001\",\n        \"actualValue\": 0.95,\n        \"comments\": \"Completed all scheduled site milestones on plan.\"\n      },\n      {\n        \"criterionId\": \"00000000-0000-0000-0000-000000000002\",\n        \"actualValue\": 0.92,\n        \"comments\": \"Zero major consultant snag rejections.\"\n      }\n    ],\n    \"notes\": {\n      \"strengths\": \"Exceptional site discipline and fast cable termination delivery.\",\n      \"growthAreas\": \"Improve integration timing with HVAC interface trip tests.\",\n      \"recommendations\": \"Recommend Cisco Certified Network Associate (CCNA) certification.\"\n    },\n    \"submitToHr\": true\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/_server/saveQuarterlyEvaluation",
